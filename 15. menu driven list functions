#menu driven list functions

l = list("ABCDEF")
print(l)
print("======List Functions======")
for i in ["1. Append","2. Extend","3. Insert","4. Remove","5. Pop","6. Clear"]:
    print(i)

while True:
    ch = input("Enter your choice:")
    if ch == "1":
        c = int(input("Enter a new element: "))
        print(l.append(c))
        
        
    elif ch == "2":
        l2 = [1,2]
        print(l.extend(l2))
        
    elif ch == "3":
        n = int(input("Enter a position to insert a new element: "))
        m = int(input("Enter new element: "))
        print(l.insert(n,m))
    elif ch == "4":
        m = input("Enter element to be removed: ")
        print(f"removing {m} from {l} ")
        l.remove(m)
        print(f"Result: {l}")
    elif ch == "5":
        print(f"deleted {m} from {l}")
        m = l.pop()
        print(l)
    elif ch == "6":
        l.clear()
        print("Cleared List ",l)
    elif ch == "Exit" or ch == "exit":
        break
    else:
        print("Invalid choice".center(40,"!"))
    






