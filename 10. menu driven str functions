#code to implement string functions
nig = "MY NAME IS SHLOK"
print("String functions")
print(nig)
print("1. Slice")
print("2. count")
print("3. find")
print("4. capitalize")
print("5. title")
print("6. lower")
print("7. upper")
print("8. swapcase")
print("9. replace")
print("10. join")
print("11. isspace")
print("12. isdigit")
print("13. split")
print("14. startswith")
print("15. endswith")
print("16. casefold")
print("17. center")
print("18. encode")
print("19. format")
print("20. strip")
print("Exit")

while True:
    ch = input("Enter choice:")
    if ch == '1':
        print(slice(2,10))
        sli = slice(2,10)
        print(nig[sli])
    elif ch == '2':
        coun = input("Enter substring to count:")
        print(nig.count(coun))
    elif ch == '3':
        fin = input("find substring:")
        print(nig.find(fin))
    elif ch == '4':
        cap = nig.capitalize()
        print(cap)
    elif ch == '5':
        tit = nig.title()
        print(tit)
    elif ch == '6':
        print(nig.lower())
    elif ch == '7':
        print(nig.upper())
    elif ch == '8':
        print(nig.swapcase())
    elif ch == '9':
        nam = input("Enter your name:")
        old = "SHLOK"
        print(nig.replace(old,nam))
    elif ch == '10':
        sentence = "+".join(nig)
        print(sentence)
    elif ch == '11':
        print(nig.isspace())
    elif ch == '12':
        print(nig.isdigit())
    elif ch == '13':
        print(nig.split())
    elif ch == '14':
        print(f"checking if {nig} starts with an M: ", nig.startswith("M"))
    elif ch == '15':
        print(f"checking if {nig} ends with a F: ", nig.endswith("F"))
    elif ch == '16':
        print(nig.casefold())
    elif ch == '17':
        print(nig.center(36, "-"))
    elif ch == '18':
        print(nig.encode())
    elif ch == '19':
        print("{1} and {0} are inseparable.".format("Geto","Gojo"))        
    elif ch == '20':
        doofus = "BOMBOCLATT".center(48,"#")
        print(doofus)
        print(doofus.strip("#"))
        
    elif ch == "Exit" or ch == "exit":
        break
    else:
        print("Invalid input.... please try again!")
